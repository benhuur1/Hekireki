# Hekireki — manifesto da Primeira Forma
# Apache/LiteSpeed config para Hostinger (subdomain hekireki.infotechjs.com.br).

Options -Indexes

<IfModule mod_headers.c>
  # Assets gerados pelo Vite com hash no nome — imutáveis, cache anual
  <FilesMatch "\.(js|mjs|css|svg|woff2?|ttf|otf|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html sempre revalidar (deploy novo é visto na hora)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # competitivo.json muda pouco mas pode mudar; revalidar moderado
  <FilesMatch "competitivo\.json$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Service Worker — sempre fresco, senão usuários ficam presos numa versão antiga
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>

  # Segurança. "always" para valer também nas respostas de erro (404),
  # que é justamente onde o nosniff mais importa.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"

  # CSP. 'unsafe-inline' em script-src é inevitável aqui: o index.html usa
  # o handler inline onload no preload das fontes (e o snippet do analytics,
  # quando entrar). A alternativa correta seria nonce por request, que exige
  # servidor — impossível em hospedagem estática. Mesmo assim o CSP já barra
  # script EXTERNO injetado, que é a ameaça real num site sem input.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
</IfModule>

AddDefaultCharset UTF-8

# Compressão para clientes que aceitam
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
